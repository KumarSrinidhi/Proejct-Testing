DATABASE_URL=sqlite+aiosqlite:///./attendance.db
SECRET_KEY=your-secret-key-change-in-production
DEBUG=true
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RECOGNITION_THRESHOLD=0.6
FACE_DETECTION_THRESHOLD=0.35
ATTENDANCE_COOLDOWN_SECONDS=300
FRAME_PROCESS_INTERVAL=1.0
CUDA_ENABLED=true
GPU_STRICT_MODE=true
INSIGHTFACE_MODEL=buffalo_l
VIDEO_SOURCE_TYPE=file
VIDEO_SOURCE_PATH=
AUTO_TRAIN_ON_UPLOAD=false
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173
VITE_API_URL=http://localhost:8000
